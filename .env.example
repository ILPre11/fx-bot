# Credenziali del CONTO DEMO MetaTrader 5.
# Copia questo file in ".env" e inserisci i tuoi dati.
# Il file .env NON va mai condiviso o versionato.
MT5_LOGIN=12345678
MT5_PASSWORD=la_tua_password_demo
MT5_SERVER=MetaQuotes-Demo
# Percorso opzionale al terminale (lascia vuoto per autorilevamento):
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_PATH=

# --- Notifiche Telegram (opzionali) ---
# 1) Crea un bot con @BotFather su Telegram -> ottieni il TOKEN.
# 2) Scrivi un messaggio al tuo bot, poi ricava il CHAT_ID
#    (es. con @userinfobot, oppure te lo rileva il programma).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
